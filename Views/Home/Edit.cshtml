@model FinanceTracker.Models.Transaction

<div class="main-content">
    <div class="finance-card">
        <h3>Edit Transaction</h3>
        
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />

            <div class="form-group mb-3">
                <label>Title</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label>Amount (₹)</label>
                <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label>Type</label>
                <select asp-for="Type" id="typeSelect" class="form-control" required>
                    <option value="Loss">Loss (Expense)</option>
                    <option value="Gain">Gain (Income)</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label>Category</label>
                <select asp-for="Category" id="categorySelect" class="form-control" required>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (List<FinanceTracker.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Name" data-type="@cat.Type">
                                @cat.Icon @cat.Name
                            </option>
                        }
                    }
                    <option value="Other" data-type="both">📦 Other</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label>Source</label>
                <select asp-for="Source" class="form-control" required>
                    <option value="Cash">Cash</option>
                    <option value="Bank">Bank</option>
                </select>
            </div>

            <div class="form-group mb-4">
                <label>Date</label>
                <input asp-for="TransactionDate" type="date" class="form-control" required />
            </div>

            <button type="submit" class="btn-primary">Update Transaction</button>
            <a href="/Home/Records" class="btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@* Include the same JS as Create.cshtml so categories filter when you change Type *@
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const typeSelect = document.getElementById('typeSelect');
        const categorySelect = document.getElementById('categorySelect');
        const options = Array.from(categorySelect.options);

        function filterCategories() {
            const selectedType = typeSelect.value;
            const currentVal = categorySelect.value;
            categorySelect.innerHTML = "";

            options.forEach(option => {
                const optType = option.getAttribute('data-type');
                if (optType === selectedType || optType === "both") {
                    categorySelect.appendChild(option);
                }
            });
            categorySelect.value = currentVal;
        }

        typeSelect.addEventListener('change', filterCategories);
        filterCategories(); // Run on load
    });
</script>
