@model FinanceTracker.Models.Transaction

@{
    ViewData["Title"] = "Edit Transaction";
    // Capture the returnUrl from the URL parameters
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
}

<div class="main-content">
    <div class="finance-card">
        <h3>Edit Transaction</h3>

        @* 1. Pass returnUrl back to the Controller so it knows where to redirect *@
        <form asp-action="Edit" asp-route-returnUrl="@returnUrl" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label>Title</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label>Amount (₹)</label>
                <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label>Type</label>
                <select asp-for="Type" id="typeSelect" class="form-control" required>
                    <option value="Loss">Loss (Expense)</option>
                    <option value="Gain">Gain (Income)</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label>Category</label>
                <select asp-for="Category" id="categorySelect" class="form-control" required>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (List<FinanceTracker.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Name" data-type="@cat.Type">
                                @cat.Icon @cat.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label>Source</label>
                <select asp-for="Source" class="form-control" required>
                    <option value="Cash">Cash</option>
                    <option value="Bank">Bank</option>
                </select>
            </div>

            <div class="form-group mb-4">
                <label>Date</label>
                <input asp-for="TransactionDate" type="date" class="form-control" required
                       value="@Model.TransactionDate.ToString("yyyy-MM-dd")" />
            </div>

            <div style="display: flex; gap: 10px;">
                <button type="submit" class="btn-primary" style="flex: 1;">Update Transaction</button>
                @* 2. If returnUrl is empty, default to History (Records) *@
                <a href="@(string.IsNullOrEmpty(returnUrl) ? "/Home/Records" : returnUrl)"
                   class="btn-secondary"
                   style="flex: 1; text-decoration: none; text-align: center; display: flex; align-items: center; justify-content: center;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@* Include the filtering logic so Category matches Type *@
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const typeSelect = document.getElementById('typeSelect');
        const categorySelect = document.getElementById('categorySelect');
        const options = Array.from(categorySelect.options);

        function filterCategories(isInitialLoad = false) {
            const selectedType = typeSelect.value;
            const currentCategory = "@Model.Category";

            categorySelect.innerHTML = "";
            options.forEach(option => {
                const optType = option.getAttribute('data-type');
                if (optType === selectedType || optType === "both") {
                    categorySelect.appendChild(option);
                }
            });

            if (isInitialLoad) {
                categorySelect.value = currentCategory;
            }
        }

        typeSelect.addEventListener('change', () => filterCategories(false));
        filterCategories(true);
    });
</script>