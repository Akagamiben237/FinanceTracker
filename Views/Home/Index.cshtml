@model FinanceTracker.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="main-content">
    <header>
        <h1>Welcome Back</h1>
        <p class="text-muted">Here's your financial overview for today.</p>
    </header>

    <div class="dashboard-grid">
        <div class="finance-card">
            <div class="card-label">Total Balance</div>
            <div class="balance-amount" style="color: @(Model.TotalBalance >= 0 ? "var(--accent-success)" : "var(--accent-danger)")">
                @Model.TotalBalance.ToString("C")
            </div>
            <small style="color: var(--accent-primary)"><i class="fa-solid fa-clock"></i> @Model.TotalChange View</small>
        </div>

        <div class="finance-card">
            <div class="card-label">Cash on Hand</div>
            <div class="balance-amount" style="color: @(Model.CashBalance >= 0 ? "var(--accent-success)" : "var(--accent-danger)")">
                @Model.CashBalance.ToString("C")
            </div>
            <small class="text-muted"><i class="fa-regular fa-money-bill-1"></i> Live Update</small>
        </div>

        <div class="finance-card">
            <div class="card-label">Bank Account</div>
            <div class="balance-amount" style="color: @(Model.BankBalance >= 0 ? "var(--accent-success)" : "var(--accent-danger)")">
                @Model.BankBalance.ToString("C")
            </div>
            <small class="text-muted"><i class="fa-solid fa-building-columns"></i> Live Update</small>
        </div>
    </div>

    <!-- Spending Trends Chart -->
    <div class="finance-card" style="margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h3 style="margin:0;">Spending Trends</h3>
            <span class="text-muted">Past @Model.TotalChange period</span>
        </div>
        <div style="height: 300px; width: 100%;">
            <canvas id="spendingTrendsChart"></canvas>
        </div>
    </div>

    <div class="finance-card" style="margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h3 style="margin: 0; font-size: 1.1rem;">Monthly Budget Goal</h3>
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="color: var(--text-muted); font-size: 0.9rem;">
                    @ViewBag.ThisMonthSpend.ToString("C0") / @ViewBag.MonthlyGoal.ToString("C0")
                </span>
                <a href="/Home/Settings" style="color: var(--accent-primary); font-size: 0.9rem;"><i class="fa-solid fa-pen-to-square"></i></a>
            </div>
        </div>
        <div style="width: 100%; height: 8px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden;">
            <div style="width: @ViewBag.BudgetPercent%; height: 100%;
                        background: @(ViewBag.BudgetPercent > 90 ? "var(--accent-danger)" : "var(--accent-primary)");
                        transition: width 0.8s ease-in-out; box-shadow: 0 0 10px @(ViewBag.BudgetPercent > 90 ? "var(--accent-danger)" : "var(--accent-primary)");">
            </div>
        </div>
        <small style="display: block; margin-top: 10px; color: var(--text-muted);">
            @if (ViewBag.BudgetPercent >= 100)
            {
                <span class="text-danger"><i class="fa-solid fa-triangle-exclamation"></i> Budget Exceeded!</span>
            }
            else
            {
                <span>You have used <strong>@ViewBag.BudgetPercent.ToString("F1")%</strong> of your monthly limit.</span>
            }
        </small>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
        <!-- Recent Transactions -->
        <div class="finance-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <div>
                    <h3 style="margin:0;">Recent Activity</h3>
                </div>
                <a href="/Home/Create" class="btn-primary" style="text-decoration: none; font-size: 0.8em; padding: 8px 16px;">
                    <i class="fa-solid fa-plus"></i> Add New
                </a>
            </div>

            @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
            {
                <div style="display:flex; flex-direction: column; gap: 0.5rem;">
                    @foreach (var item in Model.RecentTransactions)
                    {
                        <div class="transaction-row" style="display:flex; justify-content: space-between; padding: 12px; border-radius: 8px; background: rgba(255,255,255,0.03); align-items: center;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                                    @if(item.Type == "Gain") { <i class="fa-solid fa-arrow-trend-up text-success"></i> }
                                    else { <i class="fa-solid fa-arrow-trend-down text-danger"></i> }
                                </div>
                                <div>
                                    <strong style="font-size: 0.95rem;">@item.Title</strong><br />
                                    <small style="color: var(--text-muted); font-size: 0.8rem;">@item.Category • @item.Source</small>
                                </div>
                            </div>
                            <div style="font-weight: 600; font-size: 1rem; color: @(item.Type == "Gain" ? "var(--accent-success)" : "var(--accent-danger)")">
                                @(item.Type == "Gain" ? "+" : "-")@item.Amount.ToString("N2")
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 2rem 0; color: var(--text-muted);">
                    <i class="fa-regular fa-folder-open" style="font-size: 2rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                    <p>No transactions recorded recently.</p>
                </div>
            }
        </div>

        <!-- Analysis -->
        <div class="finance-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h3 style="margin:0;">Analysis</h3>
                <select onchange="window.location.href='?timeframe=' + this.value" class="form-control" style="width: auto; padding: 4px 8px; font-size: 0.85rem;">
                    <option value="daily" selected="@(Model.TotalChange == "daily")">Today</option>
                    <option value="weekly" selected="@(Model.TotalChange == "weekly")">7 Days</option>
                    <option value="monthly" selected="@(Model.TotalChange == "monthly")">30 Days</option>
                </select>
            </div>

            <div style="text-align: center; margin-bottom: 2rem;">
                <small class="card-label">Spending</small>
                <div style="position: relative; height: 160px; margin-top: 10px;">
                    <canvas id="spendingDonut"></canvas>
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;">
                        <strong style="font-size: 1.2rem; color: var(--accent-danger);">@Model.SpendingData.Values.Sum().ToString("C0")</strong>
                    </div>
                </div>
            </div>

            <div style="text-align: center;">
                <small class="card-label">Income</small>
                <div style="position: relative; height: 160px; margin-top: 10px;">
                    <canvas id="gainsDonut"></canvas>
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;">
                        <strong style="font-size: 1.2rem; color: var(--accent-success);">@Model.GainsData.Values.Sum().ToString("C0")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.1)';
        
        const donutOptions = {
            cutout: '75%',
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
        };

        // --- Line Chart (Spending Trends) ---
        const ctxTrends = document.getElementById('spendingTrendsChart')?.getContext('2d');
        if (ctxTrends) {
            // Create gradient
            let gradient = ctxTrends.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, 'rgba(99, 102, 241, 0.5)'); // Indigo
            gradient.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

            new Chart(ctxTrends, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.SpendingHistory != null ? Model.SpendingHistory.Keys.ToList() : new List<string>())),
                    datasets: [{
                        label: 'Spending',
                        data: @Html.Raw(Json.Serialize(Model.SpendingHistory != null ? Model.SpendingHistory.Values.ToList() : new List<decimal>())),
                        borderColor: '#6366f1', // Indigo 500
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#6366f1',
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            backgroundColor: 'rgba(15, 23, 42, 0.9)',
                            titleColor: '#f8fafc',
                            bodyColor: '#f8fafc',
                            borderColor: 'rgba(255,255,255,0.1)',
                            borderWidth: 1,
                            padding: 10,
                            displayColors: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { borderDash: [5, 5] },
                            ticks: { callback: function(value) { return '$' + value; } }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // --- Spending Donut ---
        const ctxSpend = document.getElementById('spendingDonut')?.getContext('2d');
        if (ctxSpend) {
            new Chart(ctxSpend, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.SpendingData.Keys)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.SpendingData.Values)),
                        backgroundColor: ['#ef4444', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: donutOptions
            });
        }

        // --- Gains Donut ---
        const ctxGain = document.getElementById('gainsDonut')?.getContext('2d');
        if (ctxGain) {
            new Chart(ctxGain, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.GainsData.Keys)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.GainsData.Values)),
                        backgroundColor: ['#10b981', '#0ea5e9', '#6366f1', '#14b8a6', '#84cc16'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: donutOptions
            });
        }
    });
</script>