@using FinanceTracker.Models

@{
    ViewData["Title"] = "Settings";
}

<div class="main-content">
    <header>
        <h1>Settings</h1>
        <p class="text-muted">Manage your application preferences.</p>
    </header>

    <div class="finance-card" style="max-width: 600px;">
        <h3 style="margin-bottom: 1.5rem;">Budget Configuration</h3>
        
        <form asp-action="UpdateSettings" method="post">
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label for="monthlyBudget" style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Monthly Budget Goal</label>
                <div style="display: flex; align-items: center; background: rgba(255,255,255,0.05); border-radius: 8px; padding: 0 12px; border: 1px solid rgba(255,255,255,0.1);">
                    <span style="color: var(--text-muted);">$</span>
                    <input type="number" id="monthlyBudget" name="monthlyBudget" value="@ViewBag.MonthlyBudget" class="form-control" style="border: none; background: transparent; color: var(--text-main); width: 100%; padding: 12px;" required />
                </div>
                <small class="text-muted" style="display: block; margin-top: 5px;">This goal is used to calculate your budget progress bar on the dashboard.</small>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; padding: 12px; display: flex; justify-content: center; align-items: center; gap: 8px;">
                <i class="fa-solid fa-save"></i> Save Changes
            </button>
        </form>
    </div>
</div>
