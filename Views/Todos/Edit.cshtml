@model FinanceTracker.Models.TodoItem

@{
    ViewData["Title"] = "Edit Task";
}

<div class="main-content">
    <header>
        <h1>Edit Task</h1>
        <p class="text-muted">Update your task details.</p>
    </header>

    <div class="finance-card" style="max-width: 700px;">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Title</label>
                <input asp-for="Title" class="form-control" placeholder="What needs to be done?" required />
            </div>

            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Description (Optional)</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Add more details..." style="resize: vertical;"></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <div class="form-group">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Priority</label>
                    <select asp-for="Priority" class="form-control">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>

                <div class="form-group">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Due Date</label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                </div>

                <div class="form-group">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Status</label>
                    <select asp-for="IsCompleted" class="form-control">
                        <option value="false">Active</option>
                        <option value="true">Completed</option>
                    </select>
                </div>
            </div>

            <div class="finance-card" style="background: rgba(99, 102, 241, 0.1); border: 1px dashed var(--accent-primary); margin-bottom: 1.5rem;">
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--text-main);">
                        <input type="checkbox" asp-for="IsFinancial" id="financialToggle" style="width: 18px; height: 18px; accent-color: var(--accent-primary);" />
                        <span><i class="fa-solid fa-dollar-sign"></i> This is a financial task</span>
                    </label>
                </div>

                <div id="financialFields" style="display: none;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div class="form-group">
                            <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Amount</label>
                            <div style="display: flex; align-items: center; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 10px; padding: 0 12px;">
                                <span style="color: var(--text-muted);">$</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control" style="border: none; background: transparent;" placeholder="0.00" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Category</label>
                            <select asp-for="Category" class="form-control">
                                <option value="">Select Category</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Name">@cat.Icon @cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 1rem;">
                <button type="submit" class="btn-primary" style="flex: 1;"><i class="fa-solid fa-save"></i> Save Changes</button>
                <a href="/Todos" class="btn-secondary" style="flex: 1; text-align: center; text-decoration: none;">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const toggle = document.getElementById('financialToggle');
        const fields = document.getElementById('financialFields');
        
        function updateVisibility() {
            fields.style.display = toggle.checked ? 'block' : 'none';
        }
        
        toggle.addEventListener('change', updateVisibility);
        updateVisibility();
    });
</script>
